<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CVE Exposure Report — {{ report.cve_id }}</title>
<style>
  :root {
    --rh-red: #ee0000;
    --rh-red-dark: #a30000;
    --rh-red-light: #ff442b;
    --bg: #151515;
    --surface: #1f1f1f;
    --surface-raised: #292929;
    --border: #3c3f42;
    --text: #e0e0e0;
    --text-secondary: #a3a3a3;
    --pass: #3e8635;
    --pass-light: #5ba352;
    --pass-bg: rgba(62, 134, 53, 0.12);
    --fail: #c9190b;
    --fail-light: #f56e6e;
    --fail-bg: rgba(201, 25, 11, 0.10);
    --warn: #f0ab00;
    --warn-bg: rgba(240, 171, 0, 0.10);
    --info: #06c;
    --info-bg: rgba(0, 102, 204, 0.10);
    --accent: #73bcf7;
    --font: 'Red Hat Display', 'Red Hat Text', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: var(--font);
    background: var(--bg);
    color: var(--text);
    padding: 2rem;
    line-height: 1.6;
  }
  .container { max-width: 1100px; margin: 0 auto; }

  header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 3px solid var(--rh-red);
  }
  .logo {
    width: 40px; height: 40px;
    background: var(--rh-red);
    border-radius: 4px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 1.1rem; color: white; flex-shrink: 0;
  }
  .header-text h1 { font-size: 1.6rem; font-weight: 700; color: #fff; }
  .header-meta { color: var(--text-secondary); font-size: 0.85rem; margin-top: 0.2rem; }
  .header-meta strong { color: var(--text); }

  .severity-badge {
    display: inline-block;
    padding: 0.3rem 1rem;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-left: auto;
  }
  .severity-critical { background: var(--fail-bg); color: var(--fail-light); border: 1px solid var(--fail); }
  .severity-high { background: rgba(240,171,0,0.15); color: var(--warn); border: 1px solid var(--warn); }

  .score-hero {
    display: flex;
    align-items: center;
    gap: 2rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2rem;
  }
  .score-ring {
    position: relative;
    width: 140px; height: 140px; flex-shrink: 0;
  }
  .score-ring svg { width: 140px; height: 140px; transform: rotate(-90deg); }
  .score-ring .ring-bg { fill: none; stroke: var(--border); stroke-width: 10; }
  .score-ring .ring-fill { fill: none; stroke-width: 10; stroke-linecap: round; }
  .score-ring .score-label {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%); text-align: center;
  }
  .score-ring .score-number { font-size: 2.5rem; font-weight: 900; line-height: 1; }
  .score-ring .score-unit {
    font-size: 0.7rem; color: var(--text-secondary);
    text-transform: uppercase; letter-spacing: 0.05em;
  }

  .score-details { flex: 1; }
  .score-details h2 { font-size: 1.1rem; font-weight: 700; color: #fff; margin-bottom: 0.75rem; }
  .vector-display {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.8rem;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.6rem 1rem;
    color: var(--rh-red-light);
    margin-bottom: 0.75rem;
    word-break: break-all;
  }
  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0.5rem;
  }
  .info-item {
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.6rem 0.75rem;
    text-align: center;
  }
  .info-item .value { font-size: 1.1rem; font-weight: 800; }
  .info-item .label {
    font-size: 0.65rem; color: var(--text-secondary);
    text-transform: uppercase; letter-spacing: 0.04em; margin-top: 0.15rem;
  }
  .info-item.critical .value { color: var(--fail-light); }
  .info-item.warn .value { color: var(--warn); }
  .info-item.accent .value { color: var(--accent); }

  .section-title {
    font-size: 1.15rem; font-weight: 700; margin: 2.5rem 0 1rem;
    padding-bottom: 0.5rem; border-bottom: 2px solid var(--border); color: #fff;
  }

  table {
    width: 100%; border-collapse: collapse;
    background: var(--surface); border-radius: 8px;
    overflow: hidden; border: 1px solid var(--border); margin-bottom: 1rem;
  }
  th {
    text-align: left; padding: 0.75rem 1rem;
    background: var(--surface-raised); color: var(--text-secondary);
    font-weight: 600; font-size: 0.75rem;
    text-transform: uppercase; letter-spacing: 0.05em;
    border-bottom: 1px solid var(--border);
  }
  td {
    padding: 0.6rem 1rem; border-bottom: 1px solid var(--border); font-size: 0.875rem;
  }
  tr:last-child td { border-bottom: none; }

  .badge {
    display: inline-block; padding: 0.2rem 0.6rem; border-radius: 4px;
    font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em;
  }
  .badge.critical { background: rgba(201,25,11,0.2); color: var(--fail-light); }
  .badge.production { background: rgba(240,171,0,0.15); color: var(--warn); }
  .badge.staging { background: var(--info-bg); color: var(--accent); }
  .badge.no-fix { background: rgba(201,25,11,0.2); color: var(--fail-light); }

  .alert-box {
    background: var(--fail-bg);
    border: 1px solid var(--fail);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }
  .alert-box .alert-icon { font-size: 1.5rem; flex-shrink: 0; }
  .alert-box .alert-title { font-weight: 700; color: var(--fail-light); margin-bottom: 0.25rem; }
  .alert-box .alert-text { color: var(--text); font-size: 0.9rem; }

  .cwe-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .cwe-tag {
    display: inline-block; padding: 0.2rem 0.6rem; border-radius: 4px;
    font-size: 0.75rem; font-weight: 600;
    background: rgba(238,0,0,0.12); color: var(--rh-red-light);
  }

  footer {
    margin-top: 3rem; padding-top: 1rem; border-top: 2px solid var(--rh-red);
    color: var(--text-secondary); font-size: 0.8rem;
    display: flex; justify-content: space-between; align-items: center;
  }
  footer .powered { color: var(--rh-red-light); font-weight: 600; }
</style>
</head>
<body>
<div class="container">
  <header>
    <div class="logo">CVE</div>
    <div class="header-text">
      <h1>CVE Exposure Report</h1>
      <div class="header-meta">
        CVE: <strong>{{ report.cve_id }}</strong>
        &nbsp;|&nbsp; Advisory: <strong>{{ report.rhtpa_advisory }}</strong>
        &nbsp;|&nbsp; {{ report.timestamp }}
      </div>
    </div>
    <span class="severity-badge severity-critical">Critical {{ report.cvss_base_score }}</span>
  </header>

  <div class="alert-box">
    <div class="alert-icon">&#9888;</div>
    <div>
      <div class="alert-title">{{ report.recommended_action }}</div>
      <div class="alert-text">
        Affected package: <strong>{{ report.affected_package }}</strong>
        &nbsp;|&nbsp; {{ report.affected_count }} host{{ 's' if report.affected_count | int > 1 else '' }} exposed
        &nbsp;|&nbsp; Fix available: <strong>{{ 'Yes' if report.fix_available else 'No' }}</strong>
      </div>
    </div>
  </div>

  <div class="score-hero">
    <div class="score-ring">
      <svg viewBox="0 0 140 140">
        <circle class="ring-bg" cx="70" cy="70" r="58"></circle>
        <circle class="ring-fill" cx="70" cy="70" r="58"
          stroke="var(--fail-light)"
          stroke-dasharray="364.4"
          stroke-dashoffset="{{ 364.4 - (364.4 * (report.cvss_base_score | float) / 10) }}">
        </circle>
      </svg>
      <div class="score-label">
        <div class="score-number" style="color: var(--fail-light)">{{ report.cvss_base_score }}</div>
        <div class="score-unit">CVSS Base</div>
      </div>
    </div>
    <div class="score-details">
      <h2>Vulnerability Assessment</h2>
      <div class="vector-display">{{ report.cvss_vector }}</div>
      <div class="info-grid">
        <div class="info-item critical">
          <div class="value">{{ report.affected_count }}</div>
          <div class="label">Hosts Affected</div>
        </div>
        <div class="info-item warn">
          <div class="value">{{ report.sbom_sources | length }}</div>
          <div class="label">SBOMs Matched</div>
        </div>
        <div class="info-item accent">
          <div class="value">{{ report.remediation_layer }}</div>
          <div class="label">Fix Layer</div>
        </div>
        <div class="info-item critical">
          <div class="value">{{ 'Yes' if report.fix_available else 'No' }}</div>
          <div class="label">Fix Available</div>
        </div>
      </div>
    </div>
  </div>

  <div class="section-title">Weakness Classification</div>
  <div class="cwe-tags">
{% for cwe in report.cwe_ids %}
    <span class="cwe-tag">{{ cwe }}</span>
{% endfor %}
  </div>

  <div class="section-title">Affected Hosts</div>
  <table>
    <thead>
      <tr>
        <th>Hostname</th>
        <th>FQDN</th>
        <th>Environment</th>
        <th>Internet Facing</th>
      </tr>
    </thead>
    <tbody>
{% for host in report.affected_hosts_detail | default(report.affected_hosts) %}
{% if host is mapping %}
      <tr>
        <td><strong>{{ host.hostname }}</strong></td>
        <td>{{ host.fqdn }}</td>
        <td><span class="badge {{ host.environment_type }}">{{ host.environment_type }}</span></td>
        <td>{{ 'Yes' if report.environment_exposure.internet_facing else 'No' }}</td>
      </tr>
{% else %}
      <tr>
        <td><strong>{{ host }}</strong></td>
        <td>{{ host }}</td>
        <td><span class="badge">unknown</span></td>
        <td>{{ 'Yes' if report.environment_exposure.internet_facing else 'No' }}</td>
      </tr>
{% endif %}
{% endfor %}
    </tbody>
  </table>

  <div class="section-title">SBOM Sources Matched</div>
  <table>
    <thead>
      <tr>
        <th>SBOM Source</th>
        <th>Match Type</th>
      </tr>
    </thead>
    <tbody>
{% for src in report.sbom_sources %}
      <tr>
        <td>{{ src }}</td>
        <td><span class="badge staging">PURL</span></td>
      </tr>
{% endfor %}
    </tbody>
  </table>

  <footer>
    <span>Red Hat Trusted Profile Analyzer &nbsp;|&nbsp; Advisory: {{ report.rhtpa_advisory }}</span>
    <span class="powered">Ansible Automation Platform</span>
  </footer>
</div>
</body>
</html>
